<?xml version="1.0" encoding="utf-8"?>
<!-- Thirty smooth clockwise turns, with a hard finite endpoint and no repeat timer. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="rotation" android:valueFrom="0" android:valueTo="10800"
    android:valueType="floatType" android:duration="27000" android:repeatCount="0"
    android:interpolator="@android:interpolator/linear" />

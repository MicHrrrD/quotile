<?xml version="1.0" encoding="utf-8"?>
<!-- Scale only the capsule's rectangular middle, never its rounded caps. -->
<scale xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="720" android:fillAfter="true"
    android:interpolator="@interpolator/widget_reveal_ease"
    android:fromXScale="0" android:toXScale="1"
    android:fromYScale="1" android:toYScale="1"
    android:pivotX="0%" android:pivotY="50%" />

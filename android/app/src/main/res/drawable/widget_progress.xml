<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="#E2E2E5" /><corners android:radius="999dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <!-- Scale the rounded shape's bounds. Clipping a full-width shape would square the filled end. -->
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <shape android:shape="rectangle"><solid android:color="#282828" /><corners android:radius="999dp" /></shape>
        </scale>
    </item>
</layer-list>
